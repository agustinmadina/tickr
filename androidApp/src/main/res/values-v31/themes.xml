<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 draws a splash from the launcher icon whether or not you ask for one. Left alone
      it uses the system background, which flashes light before a dark app. Pointing it at the
      icon and the app's own background makes the launch continuous instead.
    -->
    <style name="Theme.Tickr" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/tickr_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowBackground">@color/tickr_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
